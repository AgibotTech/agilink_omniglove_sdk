# Omniglove T1.5 runtime devices. Bootloader interfaces are intentionally
# excluded. Members of plugdev and the active local desktop user may access
# the Vendor Bulk device without running the SDK as root.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="cafe", ATTR{idProduct}=="4001", GROUP="plugdev", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="cafe", ATTR{idProduct}=="4002", GROUP="plugdev", MODE="0660", TAG+="uaccess"
